generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           String // STUDENT | ALUMNI | TEACHER | ADMIN
  status         String   @default("APPROVED") // PENDING | APPROVED | REJECTED
  department     String?
  studentId      String?
  batch          String? // admission year for students
  graduationYear String?
  company        String?
  designation    String? // job title; for teachers, academic rank
  location       String?
  bio            String?
  skills         String? // comma separated
  linkedin       String?
  github         String?
  image          String?
  // Contact details, each hidden unless the owner makes it public
  phone          String?
  phonePublic    Boolean  @default(false)
  whatsapp       String?
  whatsappPublic Boolean  @default(false)
  facebook       String?
  facebookPublic Boolean  @default(false)
  isPrivate      Boolean  @default(false)
  createdAt      DateTime @default(now())
  lastLoginAt    DateTime?

  jobs          Job[]
  applications  Application[]
  sentRequests  Connection[]  @relation("sent")
  gotRequests   Connection[]  @relation("received")
  messages      Message[]
  posts         Post[]
  loginLogs     LoginLog[]

  createdGroups Group[]        @relation("GroupCreator")
  groupMembers  GroupMember[]
  groupMessages GroupMessage[]

  postedTuitions      Tuition[]            @relation("PostedTuitions")
  tuitionApplications TuitionApplication[] @relation("TuitionApplications")
}

model Job {
  id           String   @id @default(cuid())
  title        String
  company      String
  location     String
  type         String // Full-time | Part-time | Internship | Contract
  category     String
  description  String
  requirements String?
  salary       String?
  deadline     DateTime?
  referral     Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  postedById   String
  postedBy     User          @relation(fields: [postedById], references: [id], onDelete: Cascade)
  applications Application[]
}

model Application {
  id        String   @id @default(cuid())
  note      String?
  status    String   @default("APPLIED") // APPLIED | SHORTLISTED | REJECTED
  createdAt DateTime @default(now())

  jobId     String
  job       Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([jobId, studentId])
}

model Connection {
  id        String   @id @default(cuid())
  note      String?
  status    String   @default("PENDING") // PENDING | ACCEPTED | DECLINED
  createdAt DateTime @default(now())

  fromId   String
  from     User      @relation("sent", fields: [fromId], references: [id], onDelete: Cascade)
  toId     String
  to       User      @relation("received", fields: [toId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([fromId, toId])
}

model Message {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  senderId     String
  sender       User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

/** Notice board: announcements, events, scholarships and research calls from teachers and alumni. */
model Post {
  id        String    @id @default(cuid())
  kind      String // Notice | Event | Scholarship | Research | Opportunity
  title     String
  body      String
  link      String?
  eventDate DateTime?
  createdAt DateTime  @default(now())

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

/** Login activity audit logs for admin analytics */
model LoginLog {
  id        String   @id @default(cuid())
  userId    String
  email     String
  name      String
  role      String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/** Pre-approved faculty and alumni directory for instant auto-approval */
model PreApprovedMember {
  id             String   @id @default(cuid())
  email          String?
  studentId      String?
  name           String?
  role           String   // ALUMNI | TEACHER
  department     String?
  designation    String?
  graduationYear String?
  batch          String?
  sourceFile     String?
  createdAt      DateTime @default(now())

  @@index([email])
  @@index([studentId])
  @@index([role])
}

/** Email OTP verification codes for secure signup */
model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

/** Messenger-style Groups for students, alumni, and teachers */
model Group {
  id          String         @id @default(cuid())
  name        String
  description String?
  image       String?
  createdAt   DateTime       @default(now())

  createdById String
  createdBy   User           @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)

  members     GroupMember[]
  messages    GroupMessage[]
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER") // ADMIN | MEMBER
  joinedAt  DateTime @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupMessage {
  id             String   @id @default(cuid())
  groupId        String
  group          Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  attachmentUrl  String?
  attachmentName String?
  attachmentSize String?
  attachmentType String?
  createdAt      DateTime @default(now())

  @@index([groupId, createdAt])
}

model Tuition {
  id                   String               @id @default(cuid())
  title                String
  classGrade           String               // e.g. "Class 9-10 (SSC)", "Class 11-12 (HSC)", "O-Level", "A-Level"
  curriculum           String               // e.g. "Bangla Medium", "English Version", "English Medium"
  subjects             String               // e.g. "Higher Math, Physics"
  tutoringType         String               // "Home Tutoring" | "Online Tutoring" | "Tutor's Place"
  location             String               // e.g. "Dhanmondi, Dhaka"
  daysPerWeek          String               // e.g. "3 Days / Week"
  salary               String               // e.g. "6,000 BDT/Month" or "Negotiable"
  studentGender        String?              // "Male" | "Female" | "Any"
  preferredTutorGender String?              // "Male Preferred" | "Female Preferred" | "Any"
  requirements         String?              // Specific tutor requirements or background
  status               String               @default("OPEN") // OPEN | CLOSED
  createdAt            DateTime             @default(now())

  postedById           String
  postedBy             User                 @relation("PostedTuitions", fields: [postedById], references: [id], onDelete: Cascade)
  applications         TuitionApplication[]

  @@index([postedById])
}

model TuitionApplication {
  id             String   @id @default(cuid())
  tuitionId      String
  tuition        Tuition  @relation(fields: [tuitionId], references: [id], onDelete: Cascade)
  applicantId    String
  applicant      User     @relation("TuitionApplications", fields: [applicantId], references: [id], onDelete: Cascade)
  expectedSalary String?
  experience     String?  // e.g. "2 years teaching SSC Physics & Math"
  availability   String?  // e.g. "After 4:30 PM, 3 days/week"
  note           String?  // cover note / pitch
  status         String   @default("APPLIED") // APPLIED | SHORTLISTED | SELECTED | REJECTED
  createdAt      DateTime @default(now())

  @@unique([tuitionId, applicantId])
  @@index([applicantId])
}


