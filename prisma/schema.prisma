generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               String    // STUDENT | ALUMNI | TEACHER | ADMIN
  status             String    @default("APPROVED") // PENDING | APPROVED | REJECTED
  emailVerified      Boolean   @default(true)
  alumniVerified     Boolean   @default(false)
  verificationMethod String?   @default("ulab_email")
  verifiedAt         DateTime?
  department         String?
  studentId          String?
  batch              String?   // admission year for students
  graduationYear     String?
  company            String?
  designation        String?   // job title; for teachers, academic rank
  location           String?
  bio                String?
  skills             String?   // comma separated
  linkedin           String?
  github             String?
  image              String?
  // Contact details, each hidden unless the owner makes it public
  phone              String?
  phonePublic        Boolean   @default(false)
  whatsapp           String?
  whatsappPublic     Boolean   @default(false)
  facebook           String?
  facebookPublic     Boolean   @default(false)
  isPrivate          Boolean   @default(false)
  // Saved CV for 1-click job applications
  savedCvUrl         String?
  savedCvName        String?
  savedCvDate        DateTime?
  // Notification preferences
  notifyEmailMessages     Boolean   @default(true)
  notifyEmailApplications Boolean   @default(true)
  notifyEmailMentorship   Boolean   @default(true)
  notifyEmailSystem       Boolean   @default(true)
  // Alumni Mentorship Settings
  isMentor                Boolean   @default(false)
  mentorAvailable         Boolean   @default(true)
  mentorTopics            String?
  mentorExpertise         String?
  mentorSessionFormat     String?   @default("ONLINE")
  mentorAvailabilityNote  String?
  mentorMaxMentees        Int       @default(3)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt @default(now())
  deletedAt          DateTime?
  lastLoginAt        DateTime?

  jobs                   Job[]
  applications           Application[]
  sentRequests           Connection[]          @relation("sent")
  gotRequests            Connection[]          @relation("received")
  messages               Message[]
  posts                  Post[]
  loginLogs              LoginLog[]

  createdGroups          Group[]               @relation("GroupCreator")
  groupMembers           GroupMember[]
  groupMessages          GroupMessage[]

  postedTuitions         Tuition[]             @relation("PostedTuitions")
  tuitionApplications    TuitionApplication[]  @relation("TuitionApplications")

  // Governance, Mentorship & Collaboration Relations
  notifications          Notification[]        @relation("UserNotifications")
  triggeredNotifications Notification[]        @relation("TriggeredNotifications")
  studentMentorships     MentorshipRequest[]      @relation("StudentMentorships")
  mentorRequests         MentorshipRequest[]      @relation("MentorRequests")
  studentRelationships   MentorshipRelationship[] @relation("StudentMentorshipRelations")
  mentorRelationships    MentorshipRelationship[] @relation("MentorRelationships")
  supportTickets         SupportTicket[]       @relation("UserTickets")
  assignedTickets        SupportTicket[]       @relation("AssignedTickets")
  submittedReports       UserReport[]          @relation("SubmittedReports")
  receivedReports        UserReport[]          @relation("ReportedUser")
  resolvedReports        UserReport[]          @relation("ResolvedReports")
  adminAuditLogs         AdminAuditLog[]       @relation("AdminAuditActions")
  blockedUsers           BlockedUser[]         @relation("BlockerUsers")
  blockedByUsers         BlockedUser[]         @relation("BlockedUsers")
  ticketMessages         TicketMessage[]       @relation("UserTicketMessages")
  updatedSettings        SystemSetting[]       @relation("UpdatedSettings")
  mentorProfile          MentorProfile?        @relation("UserMentorProfile")
  feedbackGiven          MentorshipFeedback[]  @relation("StudentFeedbackGiven")
  feedbackReceived       MentorshipFeedback[]  @relation("MentorFeedbackReceived")
  mentorshipAuditLogs    MentorshipAuditLog[]  @relation("MentorshipAuditActor")

  @@index([role])
  @@index([status])
  @@index([department])
  @@index([studentId])
  @@index([alumniVerified])
  @@index([deletedAt])
}

model Job {
  id              String        @id @default(cuid())
  title           String
  company         String
  location        String
  type            String        // Full-time | Part-time | Internship | Contract
  category        String
  description     String
  requirements    String?
  skills          String?       // comma-separated required skills
  salary          String?
  deadline        DateTime?
  referral        Boolean       @default(false)
  active          Boolean       @default(true)
  status          String        @default("PUBLISHED") // DRAFT | PUBLISHED | PAUSED | CLOSED | EXPIRED | REMOVED
  experienceLevel String?       // Entry | Mid-level | Senior
  externalUrl     String?       // optional direct application URL
  contactEmail    String?       // relevant hiring contact email or info
  viewsCount      Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt @default(now())
  deletedAt       DateTime?

  postedById      String
  postedBy        User          @relation(fields: [postedById], references: [id], onDelete: Cascade)
  applications    Application[]

  @@index([postedById])
  @@index([status])
  @@index([active])
  @@index([category])
  @@index([createdAt])
  @@index([deletedAt])
}

model Application {
  id              String    @id @default(cuid())
  note            String?
  resumeUrl       String?
  status          String    @default("APPLIED") // APPLIED | VIEWED | SHORTLISTED | INTERVIEW | SELECTED | REJECTED | WITHDRAWN
  hiringNotes     String?   // Private internal notes by job author/admin
  viewedAt        DateTime? // Timestamp when recruiter first reviewed
  statusUpdatedAt DateTime? // Timestamp of last status change
  withdrawnAt     DateTime? // Timestamp if withdrawn by student
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt @default(now())

  jobId           String
  job             Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  studentId       String
  student         User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([jobId, studentId])
  @@index([studentId])
  @@index([jobId])
  @@index([status])
}

model Connection {
  id                   String    @id @default(cuid())
  note                 String?
  status               String    @default("PENDING") // PENDING | ACCEPTED | DECLINED
  type                 String    @default("general") // general | mentorship
  topic                String?   // Mentorship topic for mentorship conversations
  mentorshipRequestId  String?   // Associated mentorship request ID
  isCompleted          Boolean   @default(false)     // True when mentorship is concluded (read-only archive)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt @default(now())

  fromId               String
  from                 User      @relation("sent", fields: [fromId], references: [id], onDelete: Cascade)
  toId                 String
  to                   User      @relation("received", fields: [toId], references: [id], onDelete: Cascade)
  messages             Message[]

  @@unique([fromId, toId, type])
  @@index([fromId])
  @@index([toId])
  @@index([status])
  @@index([type])
}

model Message {
  id             String     @id @default(cuid())
  body           String
  isRead         Boolean    @default(false)
  readAt         DateTime?
  attachmentUrl  String?
  attachmentName String?
  attachmentSize String?
  attachmentType String?
  createdAt      DateTime   @default(now())

  connectionId   String
  connection     Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User       @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([connectionId, createdAt])
  @@index([senderId])
  @@index([isRead])
}

/** User blocking to prevent harassment and unwanted direct messages */
model BlockedUser {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlockerUsers", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockedUsers", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

/** Notice board: announcements, events, scholarships and research calls from teachers and alumni. */
model Post {
  id        String    @id @default(cuid())
  kind      String    // Notice | Event | Scholarship | Research | Opportunity
  title     String
  body      String
  link      String?
  eventDate DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt @default(now())
  deletedAt DateTime?

  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([kind])
  @@index([createdAt])
  @@index([deletedAt])
}

/** Login activity audit logs for admin analytics */
model LoginLog {
  id        String   @id @default(cuid())
  userId    String
  email     String
  name      String
  role      String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

/** Pre-approved faculty and alumni directory for instant auto-approval */
model PreApprovedMember {
  id             String   @id @default(cuid())
  email          String?
  studentId      String?
  name           String?
  role           String   // ALUMNI | TEACHER
  department     String?
  designation    String?
  graduationYear String?
  batch          String?
  sourceFile     String?
  createdAt      DateTime @default(now())

  @@index([email])
  @@index([studentId])
  @@index([role])
}

/** Email OTP verification codes for secure signup */
model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

/** Messenger-style Groups for students, alumni, and teachers */
model Group {
  id          String         @id @default(cuid())
  name        String
  description String?
  image       String?
  createdAt   DateTime       @default(now())

  createdById String
  createdBy   User           @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)

  members     GroupMember[]
  messages    GroupMessage[]

  @@index([createdById])
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER") // ADMIN | MEMBER
  joinedAt  DateTime @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupMessage {
  id             String   @id @default(cuid())
  groupId        String
  group          Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  attachmentUrl  String?
  attachmentName String?
  attachmentSize String?
  attachmentType String?
  createdAt      DateTime @default(now())

  @@index([groupId, createdAt])
}

model Tuition {
  id                   String               @id @default(cuid())
  title                String
  classGrade           String               // e.g. "Class 9-10 (SSC)", "Class 11-12 (HSC)", "O-Level", "A-Level"
  curriculum           String               // e.g. "Bangla Medium", "English Version", "English Medium"
  subjects             String               // e.g. "Higher Math, Physics"
  tutoringType         String               // "Home Tutoring" | "Online Tutoring" | "Tutor's Place"
  location             String               // e.g. "Dhanmondi, Dhaka"
  daysPerWeek          String               // e.g. "3 Days / Week"
  salary               String               // e.g. "6,000 BDT/Month" or "Negotiable"
  studentGender        String?              // "Male" | "Female" | "Any"
  preferredTutorGender String?              // "Male Preferred" | "Female Preferred" | "Any"
  requirements         String?              // Specific tutor requirements or background
  status               String               @default("OPEN") // OPEN | CLOSED
  createdAt            DateTime             @default(now())

  postedById           String
  postedBy             User                 @relation("PostedTuitions", fields: [postedById], references: [id], onDelete: Cascade)
  applications         TuitionApplication[]

  @@index([postedById])
}

model TuitionApplication {
  id             String   @id @default(cuid())
  tuitionId      String
  tuition        Tuition  @relation(fields: [tuitionId], references: [id], onDelete: Cascade)
  applicantId    String
  applicant      User     @relation("TuitionApplications", fields: [applicantId], references: [id], onDelete: Cascade)
  expectedSalary String?
  experience     String?  // e.g. "2 years teaching SSC Physics & Math"
  availability   String?  // e.g. "After 4:30 PM, 3 days/week"
  note           String?  // cover note / pitch
  status         String   @default("APPLIED") // APPLIED | SHORTLISTED | SELECTED | REJECTED
  createdAt      DateTime @default(now())

  @@unique([tuitionId, applicantId])
  @@index([applicantId])
}

/** Dynamic Role & Permission management */
model RolePermission {
  id          String   @id @default(cuid())
  role        String   // STUDENT | ALUMNI | TEACHER | ADMIN
  permission  String   // e.g. "jobs:create", "posts:create", "tuition:create", "mentorship:request", "users:verify", "reports:resolve"
  description String?
  granted     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  @@unique([role, permission])
  @@index([role])
}

/** User in-app notifications */
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?  // Who triggered the action (optional)
  actor     User?    @relation("TriggeredNotifications", fields: [actorId], references: [id], onDelete: SetNull)
  title     String
  body      String
  type      String   // SYSTEM | CONNECTION | MESSAGE | APPLICATION | MENTORSHIP | TICKET | REPORT
  link      String?  // Action URL
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

/** Student to Alumni / Teacher mentorship connections */
model MentorshipRequest {
  id                    String                  @id @default(cuid())
  studentId             String
  student               User                    @relation("StudentMentorships", fields: [studentId], references: [id], onDelete: Cascade)
  mentorId              String
  mentor                User                    @relation("MentorRequests", fields: [mentorId], references: [id], onDelete: Cascade)
  topic                 String                  // Career Guidance | Resume Review | Technical Interview | Industry Transition | Research | Startup
  message               String
  careerGoals           String?                 // Student's specified career goals
  reason                String?                 // Reason for request
  introduction          String?                 // Short introduction of student
  preferredAvailability String?                 // Preferred days/hours
  status                String                  @default("PENDING") // PENDING | ACCEPTED | DECLINED | SCHEDULED | COMPLETED | CANCELLED
  sessionFormat         String?                 // ONLINE | IN_PERSON | HYBRID
  scheduledAt           DateTime?               // When session is scheduled
  sessionLink           String?                 // Virtual meeting URL or physical location
  mentorNotes           String?
  startedAt             DateTime?               // When relationship started
  completedAt           DateTime?
  declinedAt            DateTime?
  cancelledAt           DateTime?
  endReason             String?                 // Optional reason when ended/cancelled
  connectionId          String?                 // Dedicated Conversation connection ID
  relationship          MentorshipRelationship?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt @default(now())

  @@index([studentId])
  @@index([mentorId])
  @@index([status])
  @@index([createdAt])
}

/** Active or historical Mentorship Relationship separate from the request workflow */
model MentorshipRelationship {
  id           String            @id @default(cuid())
  requestId    String            @unique
  request      MentorshipRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  studentId    String
  student      User              @relation("StudentMentorshipRelations", fields: [studentId], references: [id], onDelete: Cascade)
  mentorId     String
  mentor       User              @relation("MentorRelationships", fields: [mentorId], references: [id], onDelete: Cascade)
  status       String            @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  startedAt    DateTime          @default(now())
  endedAt      DateTime?
  endReason    String?
  connectionId String?           // ID of the dedicated Connection for direct messaging
  feedback     MentorshipFeedback?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt @default(now())

  @@index([studentId])
  @@index([mentorId])
  @@index([status])
}

/** Comprehensive Career Mentor profile for verified Alumni and Faculty */
model MentorProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation("UserMentorProfile", fields: [userId], references: [id], onDelete: Cascade)
  isActive               Boolean  @default(false) // Whether mentor mode is enabled
  status                 String   @default("AVAILABLE") // AVAILABLE | TEMPORARILY_UNAVAILABLE | FULLY_BOOKED
  bio                    String?  // Professional introduction / statement
  careerField            String?  // Career field / industry
  company                String?  // Current company
  position               String?  // Current position
  department             String?  // Academic department
  expertise              String?  // Areas of expertise
  skills                 String?  // Technical & soft skills (comma-separated)
  topics                 String?  // Mentorship topics (comma-separated)
  yearsOfExperience      Int?     // Years of professional experience
  preferredSessionType   String   @default("ONLINE") // ONLINE | IN_PERSON | HYBRID
  availableDays          String?  // Comma-separated (e.g. "Sunday, Tuesday, Thursday")
  communicationMethod    String   @default("GOOGLE_MEET") // GOOGLE_MEET | ZOOM | IN_PERSON | CAMPUS | EMAIL
  maxMentees             Int      @default(3) // Maximum active concurrent mentees (1-10)
  availabilityNote       String?  // Additional scheduling / timing notes
  averageRating          Float?   // Cached average rating (1.0 - 5.0)
  totalReviews           Int      @default(0) // Total count of feedback reviews
  // Faculty specific academic fields
  academicExpertise      String?  // Academic / subject expertise
  researchInterests      String?  // Research interests
  teachingAreas          String?  // Teaching areas
  academicGuidanceTopics String?  // Academic guidance topics
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt @default(now())

  @@index([isActive])
  @@index([status])
  @@index([careerField])
  @@index([department])
}

/** Feedback and ratings submitted by students upon completing a mentorship */
model MentorshipFeedback {
  id             String                 @id @default(cuid())
  relationshipId String                 @unique
  relationship   MentorshipRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  studentId      String
  student        User                   @relation("StudentFeedbackGiven", fields: [studentId], references: [id], onDelete: Cascade)
  mentorId       String
  mentor         User                   @relation("MentorFeedbackReceived", fields: [mentorId], references: [id], onDelete: Cascade)
  rating         Int                    // 1 to 5
  review         String?                // Optional written review
  isAnonymous    Boolean                @default(false)
  status         String                 @default("PUBLISHED") // PUBLISHED | PENDING_REVIEW | HIDDEN | FLAGGED
  isReported     Boolean                @default(false)
  reportReason   String?
  adminNotes     String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt @default(now())

  @@index([mentorId])
  @@index([studentId])
  @@index([rating])
  @@index([status])
}

/** Traceable audit trail for mentorship actions across users and administrators */
model MentorshipAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("MentorshipAuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  action     String   // MENTOR_ACTIVATION | MENTOR_DEACTIVATION | REQUEST_CREATION | REQUEST_ACCEPTANCE | REQUEST_DECLINE | RELATIONSHIP_COMPLETION | RELATIONSHIP_CANCELLATION | REPORT_SUBMISSION | ADMIN_MODERATION
  targetType String   // MENTOR_PROFILE | MENTORSHIP_REQUEST | MENTORSHIP_RELATIONSHIP | USER_REPORT | FEEDBACK
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([targetType])
  @@index([createdAt])
}

/** Support and Helpdesk ticketing system */
model SupportTicket {
  id            String          @id @default(cuid())
  ticketNumber  String          @unique // Sequential human-readable ticket reference e.g. "TICK-1001"
  userId        String
  user          User            @relation("UserTickets", fields: [userId], references: [id], onDelete: Cascade)
  subject       String
  description   String
  category      String          // LOGIN | VERIFICATION | PROFILE | JOB_POSTING | JOB_APPLICATION | MESSAGING | TECHNICAL | OTHER
  priority      String          @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  status        String          @default("OPEN")   // OPEN | IN_PROGRESS | WAITING_FOR_USER | RESOLVED | CLOSED
  assignedToId  String?
  assignedTo    User?           @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolution    String?
  internalNotes String?
  resolvedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt @default(now())
  messages      TicketMessage[]

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([assignedToId])
}

/** Ticket communication thread between user and support team */
model TicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String
  author     User          @relation("UserTicketMessages", fields: [authorId], references: [id], onDelete: Cascade)
  body       String
  isInternal Boolean       @default(false) // Visible only to admins for internal staff notes
  createdAt  DateTime      @default(now())

  @@index([ticketId, createdAt])
  @@index([authorId])
}

/** Trust, safety and moderation reports */
model UserReport {
  id                 String    @id @default(cuid())
  reporterId         String
  reporter           User      @relation("SubmittedReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId     String?
  reportedUser       User?     @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  targetType         String    // USER | JOB | POST | MESSAGE | TUITION | PROFILE
  targetId           String?
  reason             String    // SPAM | HARASSMENT | FAKE_IDENTITY | FRAUD | INAPPROPRIATE | FAKE_JOB | SUSPICIOUS_ACCOUNT | MISLEADING_PROFILE | OTHER
  details            String?
  status             String    @default("PENDING") // PENDING | INVESTIGATING | RESOLVED | DISMISSED
  actionTaken        String?   // WARNED | SUSPENDED | CONTENT_REMOVED | DISMISSED | NONE
  investigationNotes String?
  resolvedById       String?
  resolvedBy         User?     @relation("ResolvedReports", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNotes    String?
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt @default(now())

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
  @@index([targetType])
}

/** Comprehensive Admin & Security audit logging */
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation("AdminAuditActions", fields: [adminId], references: [id], onDelete: Cascade)
  action     String   // USER_STATUS_CHANGE | ROLE_CHANGE | USER_DELETE | JOB_TOGGLE | REPORT_RESOLVE | TICKET_UPDATE | PERMISSION_CHANGE
  targetType String   // USER | JOB | APPLICATION | SUPPORT_TICKET | USER_REPORT | POST | TUITION | PERMISSION
  targetId   String?
  details    String?  // JSON context or summary
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([targetType])
  @@index([createdAt])
}

/** Dynamic platform configurations, institutional policies and security thresholds */
model SystemSetting {
  key         String   @id
  value       String   // JSON string or scalar value
  category    String   // PLATFORM | NOTIFICATION | PRIVACY | ROLES | JOBS | SUPPORT | SECURITY
  label       String
  description String?
  updatedById String?
  updatedBy   User?    @relation("UpdatedSettings", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt @default(now())

  @@index([category])
}
