DATABASE_URL="file:./dev.db"
AUTH_SECRET="generate-with: openssl rand -hex 32"
CAREERJET_API_KEY=""

# Email / OTP Verification (Gmail / Google Workspace / ULAB email)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-email@ulab.edu.bd"
SMTP_PASS="your-16-character-google-app-password"
EMAIL_FROM="ULAB Setu <your-email@ulab.edu.bd>"

# Optional: Resend API Key (alternative)
# RESEND_API_KEY="re_..."

# Google Maps Platform (Global Alumni Network Map & Satellite Explorer)
# 1. Enable 'Maps JavaScript API' in Google Cloud Console
# 2. Restrict HTTP referrers to: localhost:*, ulab-setu.vercel.app/*
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Optional: Google Maps Map ID for Advanced Markers or vector styling
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""

# Cloudflare Turnstile Anti-Bot Protection (Optional)
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=""
CLOUDFLARE_TURNSTILE_SECRET_KEY=""
